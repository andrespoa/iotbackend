# ==========================================
# CONFIGURACIÓN DEL BACKEND IoT
# RENDER + SUPABASE
# ==========================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo a api.env
# 2. Llenar los valores de Supabase
# 3. Deployar en Render
#
# ==========================================

# ===== SUPABASE (Render Production) =====
# Obtener en: https://app.supabase.com/project/[project-id]/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...

# ===== UBICACIÓN DEL LAB =====
# Coordenadas geográficas para pronósticos
LAT=10.426571100984994
LON=-75.5376662222412

# ===== APIs EXTERNAS (OPCIONAL) =====
# OpenWeather API: https://openweathermap.org/api
OPENWEATHER_KEY=tu_api_key_openweather

# Google Gemini API: https://ai.google.dev
GEMINI_API_KEY=tu_api_key_google_gemini

# ===== FLASK CONFIGURATION =====
FLASK_ENV=production
FLASK_DEBUG=False

# ===== MACHINE LEARNING =====
MODEL_PATH=model_rf.joblib
# Mínimo de filas para entrenar modelo
MIN_ROWS_TO_TRAIN=200

# ===== CORS =====
# URLs permitidas para CORS (separadas por comas)
# * = Permitir todas las URLs (desarrollo)
CORS_ORIGINS=*
