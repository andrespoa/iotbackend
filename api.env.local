# ==========================================
# CONFIGURACIÓN LOCAL DEL BACKEND IoT
# ==========================================
# 
# SOLO PARA DESARROLLO LOCAL
# Copiar como: api.env en la carpeta backend/
#
# ==========================================

# ===== DATABASE SELECTION =====
# Para desarrollo LOCAL: false
# Para PRODUCCIÓN en Render: true
USE_SUPABASE=false

# ===== SUPABASE (Ignorar para desarrollo local) =====
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...

# ===== MYSQL LOCAL =====
# Cambiar según tu setup local
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_iot

# ===== UBICACIÓN DEL LAB =====
LAT=10.426571100984994
LON=-75.5376662222412

# ===== APIs EXTERNAS (OPCIONAL) =====
OPENWEATHER_KEY=
GEMINI_API_KEY=

# ===== FLASK CONFIGURATION =====
FLASK_ENV=development
FLASK_DEBUG=True

# ===== MACHINE LEARNING =====
MODEL_PATH=model_rf.joblib
MIN_ROWS_TO_TRAIN=200

# ===== CORS =====
CORS_ORIGINS=*
